# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of iOS, none of which belongs in the repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/README.md
!/ci/
!/.github/
!/.editorconfig
!/.gitattributes
!/build.sh
!/release.conf
!/Makefile
!/LICENSE
!/LICENSE.APSL
!/NOTICE
!/devices/
!/docs/
!/xnu/mkxnuimg.py
!/xnu/xnu-build.sh
!/xnu/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/userland/
!/sysimage/
!/xnu/
!/xnu-deps/
!/prebuilt/
!/wifi/

__pycache__/
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/loader.c
!/xnuloader/s20_memory.h
!/xnuloader/s20_efi_memory.h
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

/userland/*
!/userland/software-passcode-config.sh
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.hakios.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/
!/userland/var-y2s/
!/userland/defaults/

/sysimage/*
!/sysimage/fetch.sh
!/sysimage/*.py
/sysimage-y2s/

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize
/tools/macos-bin/platform-tools/

# made at build time from the device tree of the builder's own IPSW (xnuloader/mkidentity.sh)
/xnuloader/identity.h
!/xnuloader/im4p.py
!/xnuloader/mkidentity.sh

# y2sios overlay and the x1slte (SM-G980F) port
!/common/
!/userland/build-gpu-y2s.sh
!/userland/rc.*
!/userland/*.plist
!/userland/m2m.tour
!/userland/hfs-kit.bin
!/userland/hfs-kit-*.bin
!/userland/mkjobs.py
!/userland/mkeagl.py
!/userland/libmini/
!/x1slte.sh
!/y2s.sh
/common/devices/*.local.conf

# secrets and fetched prefixes (2026-11-06): never in the repository
/ssh/
/jb/

# Private release inputs, caches, local identities and generated payloads.
/.cache/
/inputs/
/dist/
**/.DS_Store
**/*.local.conf

# research notes and debug images: kept on this Mac, not published (user, 2026-11-20)
docs/research/

# build outputs and device state that must never be committed (2026-11-25 cleanup)
/tools/cellular/telephonyd/out/
/tools/oslogq/oslogq
/userland/var/root/Library/Lockdown/
